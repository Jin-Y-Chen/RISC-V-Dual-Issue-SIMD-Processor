{
  "flags": "-f rtl/project.f -F tb/slang-server.f",
  "index": [
    {
      "dirs": [
        "rtl",
        "tb"
      ],
      "excludeDirs": [
        "build",
        "sim",
        "node_modules",
        "loaders",
        "cases",
        "common"
      ]
    }
  ],
  "buildPattern": "tb/s1_fetch/{}.f",
  "builds": [
    {
      "glob": "tb/s1_fetch/*_tb.f"
    }
  ]
}
