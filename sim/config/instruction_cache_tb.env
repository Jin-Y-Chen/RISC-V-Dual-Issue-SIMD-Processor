# Optional per-top settings (sourced by sim/run.sh).
# Relative plusarg paths are resolved under sim/out/<top>/.
EXTRA_SRCS=(tb/include/imem_hex_loader_pkg.sv)
_mem="${MEM_FILE:-${ROOT}/program/bin/demo_instructions.mem}"
PLUSARGS+=("imem_mem=${_mem}")
PLUSARGS+=("cache_dump=icache_bank.txt")
ARTIFACTS+=("icache_bank.txt")
